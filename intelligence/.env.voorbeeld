# ============================================================
# VIBE ENERGY INTELLIGENCE — omgevingsvariabelen
# ------------------------------------------------------------
# Kopieer naar intelligence/.env. Dat bestand staat in .gitignore.
#
# BELANGRIJK: de statische site wordt vanaf de repositorywortel
# publiek geserveerd (gemeten: https://www.vibeenergy.nl/package.json
# geeft HTTP 200). Een .env in deze map zou dus publiek leesbaar
# zijn als hij ooit gecommit wordt. Dotbestanden worden door de
# host niet geserveerd (/.git/HEAD geeft 404), maar vertrouw daar
# niet op: zet geheimen in productie altijd in de omgeving van de
# Railway-service, niet in een bestand.
# ============================================================

# --- verplicht ---
INTEL_OMGEVING=ontwikkel
INTEL_DB_URL=postgresql://gebruiker@127.0.0.1:5433/vibe_intel_dev

# --- database ---
# Rol die de applicatie aanneemt. Mag geen eigenaar, superuser of
# BYPASSRLS zijn; `npm run poort` controleert dat.
INTEL_DB_APP_ROL=vibe_intel_app
INTEL_DB_ONDERHOUD_ROL=vibe_intel_onderhoud
INTEL_DB_POOL_MAX=8

# --- organisatie en site ---
INTEL_ORGANISATIE=vibe-energy
# Wortel van de statische site; standaard de worktree boven intelligence/.
# INTEL_SITE_WORTEL=/pad/naar/vibe-website
INTEL_SITE_BASIS_URL=https://www.vibeenergy.nl

# --- model ---
# Zonder sleutel draait het platform door: de pijplijn doet dan alleen
# het deterministische deel en maakt geen concepten.
INTEL_AI_PROVIDER=openai
INTEL_AI_MODEL=gpt-5
OPENAI_API_KEY=
INTEL_AI_MAX_TOKENS_UIT=2000

# --- dashboard ---
INTEL_DASHBOARD_POORT=4320
# Minimaal 32 tekens; nodig voor ondertekende sessiecookies.
INTEL_SESSIE_GEHEIM=

# --- netwerk en logging ---
INTEL_LOG_NIVEAU=info
INTEL_USER_AGENT=VibeEnergyIntelligence/0.1 (+https://www.vibeenergy.nl; contact: sales@vibeenergy.nl)
INTEL_NETWERK_TIMEOUT_MS=20000
# Op 0 zetten in tests die geen netwerk mogen raken.
INTEL_NETWERK_TOEGESTAAN=1

# --- koppelingen (leeg = NIET AANGESLOTEN, en dat rapporteert het dashboard zo) ---
INTEL_GSC_CLIENT_EMAIL=
INTEL_GSC_PRIVATE_KEY=
INTEL_GSC_SITE_URL=
INTEL_BING_API_KEY=
INTEL_BING_SITE_URL=
INTEL_GA4_PROPERTY_ID=
INTEL_GA4_CLIENT_EMAIL=
INTEL_GA4_PRIVATE_KEY=
INTEL_CRM_SOORT=
INTEL_CRM_TOKEN=
